rename <- function(ex){
    ## rename from 1 up for each new number
    ## if we encounter something we've seen before we should rename it according to past ruleset
    int <- 1:length(ex)
    o <- order(abs(ex))
    exo <- ex[o]
    shuffle <- int[o]
    shuffle[o]

}

