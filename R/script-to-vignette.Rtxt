satval <-function(x, ...){
    UseMethod("satval")
}

or_clause <- function(x1, x2, x3) {
    l <- list(x1, x2, x3)
    class(l) <-'or_clause'
    return(l)
}

or_vec <- function(x) {
    or_clause(x[1], x[2], x[3])
}


and_clause <- function(x1, x2){
    l <- list(x1, x2)
    class(l) <-'and_clause'
    return(l)
}

sat_form <- function(Aclause, litstring, m = '', n = '') {
    s <- list(form = Aclause, litstring = litstring, m = m, n = n)
    class(s) <-'sat_form'
    return(s)
}


## x will be a number. If positive treat as literal.
## If negative treat as not-expression
format.literal <- function(x){
    if(x > 0){ paste0('x', x)}
    else if (x < 0){ paste0('¬', 'x', abs(x))}
    else {'XX'}
}

print.or_clause <- function(x, ...){
    x <- lapply(x, format.literal)
    s <- paste0('(', paste0( x, collapse = ' ∨ '), ')')
    cat(s)
    cat('\n')
    invisible(s)
}

print.and_clause <- function(x, ...){
    x <- lapply(x, \(x) capture.output(print(x)))
    cat(paste0(x, collapse = ' ∧ '))
    cat('\n')
}


print.sat_form <- function(x, ...){
   print(x$form)
}
