test_exp <- 1:(3*10)


accumulate_lits <- function(lits, clause_size) {
    mclause <- length(lits) %/% clause_size

    index <- 0
    for (m in 1:mclause) {
        terms <- rep(NA, times = clause_size)
        for (i in 1:clause_size) {
            index <- index + 1
            terms[i] <- lits[index]
        }
        ## construct or_clause
        clause <-or_clause(terms[[1]], terms[[2]], terms[[3]])
        if (m == 1){
            form <- clause
        } else {
            form <- and_clause(form, clause)
        }
    }
    form
}

start_frame <- function(nvec) {
    n <- length(nvec)
    m <- (n %/% 3)

    lit_frame <- tibble(lit = nvec) |>
        mutate(
            clause_id = rep(1:m[[1]], each = 3),
            )

    clause_frame <- select(lit_frame, clause_id) |>
        mutate(clause = accumulate_lits(lit_frame$lits, m))

    list(lit_frame = lit_frame, clause_frame = clause_frame)
}


random_expression <-function(m, lambda, clause_size) {
    n <- clause_size * m
    signature <- if_else(rbinom(n, size = 1, prob = 0.50) == 1, 1L, -1L)
    names <- rpois(n, lambda)

    unique_names <- length(unique(names))
    assignment <- signature * names
    form <- accumulate_lits(assignment)


    ## everything basically just for pretty printing up to here
    sat_form(form,  litstring = assignment, m = m, n = unique_names)
}




