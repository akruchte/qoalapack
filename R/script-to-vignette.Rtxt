## re-attempt downhere
n <- 30


rrademacher <- function(n, p) {
    if_else(rbinom(n, 1, p) ==1, 1, -1)
}

rename_succ <- function(x){
    retvec <- 0 * x
    for (i in seq_along(x)){
        if (i == 1) {retvec[i] <- 1}
        else if( x[i] != x[i-1]){ retvec[i] <- retvec[i-1] + 1}
        else {retvec[i] <- retvec[i-1]}
    }
retvec
}


## basic monte carlo assessment program

## now add error handling, pop it on a trampoline, etc
## we'll migrate this into racket now to make it easier to study, but make calls to Rcmd for statistical calls

## regression strategy
## group by literal name and perform exact logistic regression strategy.
## Let literals be the
monte <- function(){
    set.seed(42)
    n <- 30
    init <- tibble(id = 1:n) |>
        mutate(string = rpois(n, 5)) |>
        group_by(string) |>
        mutate(rename = min(id)) |>
        arrange(rename) |>
        ungroup() |>
        mutate(
            sign = rrademacher(n, 8/9),
            rename = rename_succ(rename),
            nlit = max(rename))

    or_frame <- mutate(init,
                       group_clause = rep(1:(n/3), each = 3)) |>
        group_by(group_clause) |>
        summarize(or_clause = list(or_vec(rename * sign )))

    wac <- reduce(or_frame$or_clause, and_clause)

    nlit <- init$nlit[1]
    witframe <- tibble(rename = 1:nlit, assignment = rbinom(nlit, 1, 8/9))

    evaluator_frame <- left_join(init, witframe)


    evaluator <- function(assignment, sign){
        evaluation <- if_else(sign ==1,
                              assignment,
                              1 - assignment)
    }

    valuation <- function(evaluator_frame) {
        with(evaluator_frame,
             assignment,  sign)
    }

    satisfaction <- function(valuation) {
        groups <- rep(1:(length(valuation)/3), each = 3)

        reduce(lapply(split(valuation, groups), sum), prod)
    }

    satisfaction(valuation(evaluator_frame))
}




